# Copy to backend/.env and fill in. Never commit .env.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional instead of the Auth Token for sending: Standard API key (Console > Account > API keys)
# Keep TWILIO_AUTH_TOKEN as well if VALIDATE_SIGNATURE=1, webhooks are signed with it.
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM=+1xxxxxxxxxx
# Public URL of this backend (ngrok http 8000) – Twilio sends webhooks here
PUBLIC_URL=https://xxxx.ngrok-free.app
# Verified phone that receives all demo SMS/calls (synthetic patients have fake numbers)
DEMO_TO=+420xxxxxxxxx
# Max real messages per "send" click; the rest is simulated
LIVE_LIMIT=1
VOICE_NAME=Google.cs-CZ-Standard-A
# Voice: gather = read the script + keys 1/2 (safe fallback); relay = AI conversation (ConversationRelay, cs-CZ)
VOICE_MODE=gather
# WhatsApp sandbox sender (Twilio default sandbox number)
TWILIO_WHATSAPP_FROM=+14155238886
# Practice phone shown in patient texts (optional)
PRACTICE_PHONE=
# AI understanding of replies: anthropic | openai | azure (empty = rules only)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Cloudflare Tunnel token (deploy/docker-compose.yml, profile "tunnel")
TUNNEL_TOKEN=
# Natural Czech voice for calls (ElevenLabs). Without the key Twilio's built-in voice is used.
ELEVENLABS_API_KEY=
# Voice ID from the ElevenLabs Voice Library (pick one that sounds natural in Czech)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# E-mail (Twilio SendGrid): API key with Mail Send, a verified single sender, and the demo inbox
SENDGRID_API_KEY=
EMAIL_FROM=
DEMO_EMAIL=
# Or Gmail SMTP with an app password (Google account > Security > App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 1 = the demo clock ("Další den") may send real messages; default 0 simulates them
TICK_LIVE=0

# FHIR server (InterSystems IRIS for Health, hackathon kit). Patients are loaded from it (/api/fhir/sync),
# every journey step is written back (Communication, Task). Seed it once with POST /api/fhir/push.
FHIR_BASE=
FHIR_USER=
FHIR_PASSWORD=

# Password for the web app and API (challenge data must not be public). Webhooks, /p/ patient page, audio and
# /api/health stay open. Empty = no password.
DEMO_USER=plice
DEMO_PASSWORD=

# Demo recipient: presenters can set another phone / e-mail in the demo panel (stored next to the state file).
DEMO_ALLOWED_PREFIXES=+420      # comma-separated; only numbers with these prefixes (Twilio geo permissions!)
DEMO_DAILY_LIMIT=30             # live sends per day to one recipient
WHATSAPP_JOIN=                  # e.g. "join word-word", shown in the panel for the Twilio WhatsApp sandbox
