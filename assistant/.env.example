# assistant/.env (mode 600, gitignored). This container deliberately does not read backend/.env.
PUBLIC_URL=https://asistent.jsemvcas.cz
ASSISTANT_ACCESS_CODE=          # access code of the demo page
ASSISTANT_SECRET=               # random, signs cookies and encrypts Google tokens: openssl rand -hex 32
ASSISTANT_NUMBERS=+19804731320  # comma separated pool of Twilio numbers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: summaries by e-mail without Google
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional: "Connect Google"; redirect URI {PUBLIC_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
