{
  "_about": "Guided demo (backend/scenario.py, cases/README.md 'scenario.json'): the visitor is the debtor. SMS from the creditor with the secure link, identity check on the page (birth date shown in the demo panel), the options, the assistant's call, the promise, demo days until the promise is due (this persona never pays: keeps=false, hooks._kept), the reminder. Texts: messages.cs.json 'scenario'.",
  "persona": {
    "name": "Tomáš Dvořák",
    "sex": "M",
    "age": 41,
    "birthDate": "1985-04-12",
    "city": "Brno",
    "product": "loan",
    "contract": "SU-2025-04821",
    "principal": 60000,
    "balance": 38200,
    "instalment": 2150,
    "outstanding": 6450,
    "dpd": 34,
    "dueSince": "2026-09-15",
    "promises": [],
    "income": "reduced",
    "otherLoans": 1,
    "vulnerable": null,
    "dispute": null,
    "pref": "sms",
    "phone": "{phone}",
    "email": "{email}",
    "history": [],
    "flags": [],
    "segment": "temporary",
    "strategy": "plan",
    "automation": true,
    "rule": "R5",
    "reason": "34 dní po splatnosti",
    "keeps": false
  },
  "steps": [
    {"id": "sms", "do": [{"send": "sms", "variant": "FIRST_INVITE"}], "wait": {"field": "verified"}, "timeout": 20, "optional": true},
    {"id": "verify", "wait": {"field": "verified"}, "timeout": 180, "fallback": {"patch": {"verified": "{today}"}}},
    {"id": "options", "wait": {"reply": ["link"]}, "timeout": 90, "optional": true},
    {"id": "call", "after": 3, "do": [{"send": "voice", "variant": "REMINDER"}], "wait": {"reply": true}, "timeout": 150,
     "fallback": {"reply": "Zaplatím v pátek"}},
    {"id": "promise", "after": 2, "if_stage": ["promise_to_pay", "plan_active"]},
    {"id": "friday", "after": 8, "if_stage": ["promise_to_pay", "plan_active"],
     "do": [{"tick_until": ["paid", "broken_promise", "plan_offered", "human_handoff"], "max": 45}]},
    {"id": "reminder", "after": 4, "if_stage": ["broken_promise"], "do": [{"send": "sms", "variant": "BROKEN_PROMISE"}],
     "wait": {"reply": true}, "timeout": 45}
  ]
}
